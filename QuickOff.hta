<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta charset="UTF-8">
<title>QuickOff</title>
<HTA:APPLICATION
  ID="QuickOff"
  APPLICATIONNAME="QuickOff"
  VERSION="1.3"
  ICON="QuickOff.ico"
  BORDER="none"
  CAPTION="no"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="no"
  SCROLL="no"
  SINGLEINSTANCE="yes"
  WINDOWSTATE="normal"
  INNERBORDER="no"
  SELECTION="no"
  CONTEXTMENU="no"
/>
<style>
* { margin:0; padding:0; box-sizing:border-box; }

/* ── LIGHT (default) ── */
body {
  font-family: 'Segoe UI', Tahoma, sans-serif;
  background: #f5f5f5;
  color: #333;
  width: 240px;
  overflow: hidden;
  position: relative;
  border: 1px solid #d0d0d0;
}

/* ── Divider ── */
.div { height: 1px; background: #e8e8e8; }

/* ── Power buttons ── */
.pwr {
  width: 100%;
  background: transparent;
  border: none;
  border-left: 3px solid transparent;
  color: #444;
  padding: 0 14px;
  height: 30px;
  cursor: pointer;
  font-family: 'Segoe UI', sans-serif;
  font-size: 12px;
  text-align: left;
  display: -ms-flexbox;
  display: flex;
  -ms-flex-align: center;
  align-items: center;
  gap: 10px;
  transition: background 0.1s, color 0.1s, border-color 0.1s;
}
.pwr:hover { background: #ececec; color: #111; }
.pwr:active { background: #e0e0e0; }
.pwr .ic { font-size: 11px; width: 14px; text-align: center; flex-shrink: 0; color: #bbb; }
.pwr:hover .ic { color: inherit; }
.h-btn:hover  { border-left-color: #8b5cf6; }
.sl-btn:hover { border-left-color: #06b6d4; }
.sd-btn:hover { border-left-color: #ef4444; }
.rs-btn:hover { border-left-color: #f97316; }
.lk-btn:hover { border-left-color: #eab308; }
.lo-btn:hover { border-left-color: #6366f1; }

/* ── Delay row ── */
#delay-row {
  display: -ms-flexbox;
  display: flex;
  -ms-flex-align: center;
  align-items: center;
  padding: 4px 14px;
  gap: 6px;
  background: #efefef;
  border-top: 1px solid #e0e0e0;
}
#delay-row label { font-size: 10px; color: #999; -ms-flex:1; flex:1; }
#delay-val {
  width: 38px;
  background: #fff;
  border: 1px solid #d0d0d0;
  border-radius: 4px;
  color: #444;
  font-size: 11px;
  padding: 2px 4px;
  text-align: center;
  font-family: 'Segoe UI', sans-serif;
}
#delay-row span { font-size: 10px; color: #bbb; }

/* ── Footer ── */
#footer {
  background: #ebebeb;
  padding: 5px 10px 6px;
  border-top: 1px solid #ddd;
}
#footer-row {
  display: -ms-flexbox;
  display: flex;
  -ms-flex-align: center;
  align-items: center;
  margin-bottom: 3px;
  gap: 4px;
}

#footer-logo  { width: 14px; height: 14px; vertical-align: middle; margin-right: 4px; image-rendering: auto; }
#app-label {
  -ms-flex: 1; flex: 1;
  font-size: 9px;
  color: #bbb;
  letter-spacing: 1px;
  font-weight: 700;
  text-transform: uppercase;
  cursor: move;
  -webkit-user-select: none;
  user-select: none;
}

/* update badge */
#update-badge {
  display: none;
  background: #dcfce7;
  border: 1px solid #86efac;
  border-radius: 3px;
  color: #166534;
  font-size: 8px;
  font-weight: 700;
  padding: 2px 5px;
  cursor: pointer;
  letter-spacing: 0.4px;
  transition: background 0.1s;
}
#update-badge:hover { background: #bbf7d0; }

#btn-info {
  width: 20px; height: 18px;
  background: #e4e4e4; border: 1px solid #ccc; border-radius: 3px;
  color: #888; font-size: 11px; font-weight: 700; line-height: 16px;
  text-align: center; cursor: pointer; font-family: 'Segoe UI', sans-serif;
  transition: background 0.1s, color 0.1s;
}
#btn-info:hover { background: #d8e8f8; color: #2563eb; border-color: #93c5fd; }

#btn-theme {
  width: 20px; height: 18px;
  background: #e4e4e4; border: 1px solid #ccc; border-radius: 3px;
  color: #888; font-size: 10px; line-height: 16px;
  text-align: center; cursor: pointer; font-family: 'Segoe UI', sans-serif;
  transition: background 0.1s, color 0.1s;
}
#btn-theme:hover { background: #d4d4d4; color: #333; }

#btn-close {
  width: 20px; height: 20px; border-radius: 50%;
  background: #e0e0e0; border: 1px solid #bbb;
  color: #666; font-size: 11px; font-weight: 700; line-height: 18px;
  text-align: center; cursor: pointer; font-family: 'Segoe UI', sans-serif;
  transition: background 0.15s, color 0.15s, border-color 0.15s;
}
#btn-close:hover { background: #c0392b; border-color: #c0392b; color: #fff; }

#status {
  font-size: 9px; color: #ccc;
  text-align: center; padding: 1px 0 0;
  min-height: 13px;
}
#status.on  { color: #2563eb; }
#status.upd { color: #166534; cursor: pointer; }

/* ── Confirm overlay ── */
#overlay {
  display: none;
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(245,245,245,0.96);
  text-align: center; z-index: 50; padding-top: 34px;
}
#overlay.show { display: block; }
#ov-ic  { font-size: 22px; display: block; margin-bottom: 6px; }
#ov-ttl { font-size: 13px; font-weight: 700; color: #222; margin-bottom: 3px; }
#ov-sub { font-size: 10px; color: #aaa; margin: 0 12px 12px; line-height: 1.5; }
.ov-yes, .ov-no {
  display: inline-block; padding: 5px 16px; border-radius: 5px; border: none;
  font-family: 'Segoe UI', sans-serif; font-size: 11px; font-weight: 600;
  cursor: pointer; margin: 0 3px;
}
.ov-yes { background: #dc2626; color: #fff; }
.ov-yes:hover { background: #b91c1c; }
.ov-no  { background: #e8e8e8; border: 1px solid #ccc; color: #555; }
.ov-no:hover { background: #ddd; color: #333; }

/* ── About overlay ── */
#about-overlay {
  display: none;
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(245,245,245,0.97);
  z-index: 60; text-align: center; padding: 20px 18px 14px;
}
#about-overlay.show { display: block; }
#about-logo   { width: 48px; height: 48px; display: block; margin: 0 auto 6px; image-rendering: auto; }
#about-name   { font-size: 14px; font-weight: 700; color: #222; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 2px; }
#about-ver    { font-size: 9px; color: #bbb; letter-spacing: 0.6px; margin-bottom: 12px; }
#about-divider { height: 1px; background: #e4e4e4; margin: 0 0 10px; }
#about-built  { font-size: 10px; color: #888; line-height: 1.7; margin-bottom: 2px; }
#about-built strong { color: #333; font-weight: 600; }
#about-team   { font-size: 9px; color: #bbb; letter-spacing: 0.5px; margin-bottom: 12px; }
#btn-repo {
  display: block; width: 100%;
  background: #f6f8fa; border: 1px solid #d0d7de; border-radius: 5px;
  color: #555; font-family: 'Segoe UI', sans-serif; font-size: 10px; font-weight: 600;
  padding: 6px 0; cursor: pointer; letter-spacing: 0.4px; margin-bottom: 6px;
  transition: background 0.1s, color 0.1s, border-color 0.1s;
}
#btn-repo:hover { background: #eaeef2; border-color: #999; color: #111; }
#btn-about-close {
  display: block; width: 100%;
  background: transparent; border: 1px solid #e0e0e0; border-radius: 5px;
  color: #bbb; font-family: 'Segoe UI', sans-serif; font-size: 10px;
  padding: 5px 0; cursor: pointer;
  transition: background 0.1s, color 0.1s;
}
#btn-about-close:hover { background: #e8e8e8; color: #555; border-color: #ccc; }

/* ══════════════════════════════════════
   DARK THEME — every element has full
   readable contrast (#ccc / #eee text)
   ══════════════════════════════════════ */
body.dark { background: #111; color: #e0e0e0; border-color: #2a2a2a; }

body.dark .div { background: #1e1e1e; }

body.dark .pwr { color: #ccc; }
body.dark .pwr:hover { background: #1c1c1c; color: #fff; }
body.dark .pwr .ic { color: #555; }
body.dark .pwr:hover .ic { color: inherit; }

body.dark #delay-row { background: #0e0e0e; border-top-color: #1e1e1e; }
body.dark #delay-row label { color: #888; }
body.dark #delay-row span  { color: #666; }
body.dark #delay-val { background: #1a1a1a; border-color: #333; color: #ccc; }

body.dark #footer { background: #0d0d0d; border-top-color: #1e1e1e; }
body.dark 
#footer-logo  { width: 14px; height: 14px; vertical-align: middle; margin-right: 4px; image-rendering: auto; }
#app-label { color: #555; }

body.dark #update-badge { background: #14532d; border-color: #166534; color: #4ade80; }
body.dark #update-badge:hover { background: #166534; }

body.dark #btn-info  { background: #1e1e1e; border-color: #333; color: #888; }
body.dark #btn-info:hover  { background: #253040; color: #60a5fa; border-color: #60a5fa; }
body.dark #btn-theme { background: #1e1e1e; border-color: #333; color: #888; }
body.dark #btn-theme:hover { background: #2a2a2a; color: #eee; }
body.dark #btn-close { background: #222; border-color: #444; color: #aaa; }
body.dark #btn-close:hover { background: #c0392b; border-color: #c0392b; color: #fff; }

body.dark #status { color: #444; }
body.dark #status.on  { color: #60a5fa; }
body.dark #status.upd { color: #4ade80; }

body.dark #overlay { background: rgba(10,10,10,0.96); }
body.dark #ov-ttl { color: #eee; }
body.dark #ov-sub { color: #666; }
body.dark .ov-no  { background: #1a1a1a; border-color: #333; color: #aaa; }
body.dark .ov-no:hover { background: #222; color: #ddd; }

body.dark #about-overlay { background: rgba(10,10,10,0.97); }
body.dark #about-name   { color: #eee; }
body.dark #about-ver    { color: #555; }
body.dark #about-divider { background: #1e1e1e; }
body.dark #about-built  { color: #777; }
body.dark #about-built strong { color: #ccc; }
body.dark #about-team   { color: #444; }
body.dark #btn-repo { background: #161b22; border-color: #30363d; color: #aaa; }
body.dark #btn-repo:hover { background: #1e2530; border-color: #58a6ff; color: #eee; }
body.dark #btn-about-close { border-color: #222; color: #444; }
body.dark #btn-about-close:hover { background: #1a1a1a; color: #aaa; border-color: #333; }
</style>
</head>
<body id="body">

<!-- About overlay -->
<div id="about-overlay">
  <img id="about-logo" src="data:image/x-icon;base64," alt="QuickOff" />
  <div id="about-name">QuickOff</div>
  <div id="about-ver">v1.3 &nbsp;&middot;&nbsp; MIT License</div>
  <div id="about-divider"></div>
  <div id="about-built">Built by <strong>Yashwanth Ram Somireddy</strong></div>
  <div id="about-team">TeamExyKings</div>
  <button id="btn-repo" onclick="openRepo()">&#9654; View on GitHub</button>
  <button id="btn-about-close" onclick="hideAbout()">Close</button>
</div>

<!-- Confirm overlay -->
<div id="overlay">
  <span id="ov-ic">&#9889;</span>
  <div id="ov-ttl">Confirm</div>
  <div id="ov-sub">Proceed?</div>
  <button class="ov-yes" onclick="doAction()">Yes</button>
  <button class="ov-no"  onclick="hideOv()">No</button>
</div>

<!-- Power buttons -->
<div class="div"></div>
<button class="pwr h-btn"  onclick="ask('hibernate')"><span class="ic">&#9790;</span>Hibernate</button>
<div class="div"></div>
<button class="pwr sl-btn" onclick="ask('sleep')">    <span class="ic">&#8776;</span>Sleep</button>
<div class="div"></div>
<button class="pwr sd-btn" onclick="ask('shutdown')"> <span class="ic">&#9866;</span>Shut Down</button>
<div class="div"></div>
<button class="pwr rs-btn" onclick="ask('restart')">  <span class="ic">&#8635;</span>Restart</button>
<div class="div"></div>
<button class="pwr lk-btn" onclick="ask('lock')">     <span class="ic">&#9632;</span>Lock</button>
<div class="div"></div>
<button class="pwr lo-btn" onclick="ask('signout')">  <span class="ic">&#8594;</span>Sign Out</button>
<div class="div"></div>

<!-- Delay row -->
<div id="delay-row">
  <label>Delay</label>
  <input type="number" id="delay-val" value="0" min="0" max="3600" />
  <span>sec</span>
</div>

<!-- Footer -->
<div id="footer">
  <div id="footer-row">
    <span id="app-label"><img id="footer-logo" src="data:image/x-icon;base64," alt="" />QuickOff</span>
    <span id="update-badge" onclick="openRelease()" title="New version available">&#8593; Update</span>
    <button id="btn-info"  onclick="showAbout()"   title="About">i</button>
    <button id="btn-theme" onclick="toggleTheme()" title="Toggle theme">&#9790;</button>
    <button id="btn-close" onclick="window.close()" title="Close">&#215;</button>
  </div>
  <div id="status">Ready</div>
</div>

<script language="JavaScript">
  var GITHUB_REPO = "yashwanthramsomireddy/QuickOff";
  var CURRENT_VER = "1.3";

  function runCmd(cmd, wait) {
    try {
      var sh = new ActiveXObject("WScript.Shell");
      sh.Run(cmd, 0, wait ? true : false);
    } catch(e) { alert("Command error:\n" + e.message); }
  }

  // Window size & position
  var W = 250, H = 330;
  window.resizeTo(W, H);
  window.moveTo(screen.availWidth - W - 14, screen.availHeight - H - 46);

  var A = {
    hibernate: { ic:"&#9790;",  title:"Hibernate",  sub:"Save session to disk and power off.", cmd:"shutdown /h" },
    sleep:     { ic:"&#8776;",  title:"Sleep",       sub:"Enter low-power standby.",            cmd:'cmd /c "rundll32.exe powrprof.dll,SetSuspendState 0,1,0"' },
    shutdown:  { ic:"&#9866;",  title:"Shut Down",   sub:"Close all apps and power off.",       cmd:"shutdown /s /t 0" },
    restart:   { ic:"&#8635;",  title:"Restart",     sub:"Reboot Windows.",                     cmd:"shutdown /r /t 0" },
    lock:      { ic:"&#9632;",  title:"Lock",        sub:"Lock your session.",                  cmd:'cmd /c "rundll32.exe user32.dll,LockWorkStation"' },
    signout:   { ic:"&#8594;",  title:"Sign Out",    sub:"Sign out of Windows.",                cmd:"shutdown /l" }
  };

  var pending = "", timer = null;

  function ask(action) {
    pending = action;
    var a = A[action];
    var delay = parseInt(document.getElementById("delay-val").value) || 0;
    document.getElementById("ov-ic").innerHTML  = a.ic;
    document.getElementById("ov-ttl").innerText = a.title;
    document.getElementById("ov-sub").innerText = delay > 0 ? "In " + delay + " seconds." : a.sub;
    document.getElementById("overlay").className = "show";
  }

  function hideOv() {
    document.getElementById("overlay").className = "";
    pending = "";
  }

  function doAction() {
    var action = pending;
    hideOv();
    if (!action) return;
    var a = A[action];
    var delay = parseInt(document.getElementById("delay-val").value) || 0;
    if (action === "shutdown" || action === "restart") {
      runCmd(action === "shutdown" ? "shutdown /s /t " + delay : "shutdown /r /t " + delay);
      setStatus(delay > 0 ? a.title + " in " + delay + "s" : a.title + " sent", "on");
    } else if (delay > 0) {
      countdown(delay, a);
    } else {
      runCmd(a.cmd);
      setStatus(a.title + " sent", "on");
    }
  }

  function countdown(secs, a) {
    if (timer) clearInterval(timer);
    var left = secs;
    setStatus(a.title + " in " + left + "s", "on");
    timer = setInterval(function() {
      left--;
      if (left <= 0) {
        clearInterval(timer); timer = null;
        runCmd(a.cmd);
        setStatus(a.title + " sent", "on");
      } else {
        setStatus(a.title + " in " + left + "s", "on");
      }
    }, 1000);
  }

  function setStatus(msg, cls) {
    var el = document.getElementById("status");
    el.innerText = msg;
    el.className = cls || "";
  }

  // Theme
  var isDark = false;
  function toggleTheme() {
    isDark = !isDark;
    document.getElementById("body").className = isDark ? "dark" : "";
    document.getElementById("btn-theme").innerHTML = isDark ? "&#9788;" : "&#9790;";
  }

  // Drag
  var dragging = false, ox = 0, oy = 0;
  document.getElementById("app-label").onmousedown = function(e) {
    dragging = true; ox = e.screenX - window.screenLeft; oy = e.screenY - window.screenTop;
  };
  document.onmousemove = function(e) { if (dragging) window.moveTo(e.screenX - ox, e.screenY - oy); };
  document.onmouseup  = function()   { dragging = false; };

  // About
  function showAbout() { document.getElementById("about-overlay").className = "show"; }
  function hideAbout() { document.getElementById("about-overlay").className = "";     }
  function openRepo()  { runCmd("cmd /c start https://github.com/" + GITHUB_REPO);    }

  // Auto-update
  function checkUpdate() {
    try {
      var xhr = new ActiveXObject("Msxml2.XMLHTTP.6.0");
      xhr.onreadystatechange = function() {
        if (xhr.readyState === 4 && xhr.status === 200) {
          try {
            var data   = eval("(" + xhr.responseText + ")");
            var latest = (data.tag_name || "").replace(/^v/i, "");
            if (latest && latest !== CURRENT_VER) {
              document.getElementById("update-badge").style.display = "inline-block";
              setStatus("v" + latest + " available", "upd");
            }
          } catch(e) {}
        }
      };
      xhr.open("GET", "https://api.github.com/repos/" + GITHUB_REPO + "/releases/latest", true);
      xhr.setRequestHeader("User-Agent", "QuickOff/" + CURRENT_VER);
      xhr.send();
    } catch(e) {}
  }

  function openRelease() {
    runCmd("cmd /c start https://github.com/" + GITHUB_REPO + "/releases");
  }


  // Auto-extract icon so ICON= attribute always finds it
  (function() {
    try {
      var fso  = new ActiveXObject("Scripting.FileSystemObject");
      var htaDir = fso.GetParentFolderName(unescape(window.location.href.replace(/^file:\/\/\//i,"").replace(/\//g,"\\")));
      var icoPath = htaDir + "\\QuickOff.ico";
      if (!fso.FileExists(icoPath)) {
        var b64 = "";
        var stream = new ActiveXObject("ADODB.Stream");
        stream.Type = 1; // binary
        stream.Open();
        // decode base64 via MSXML
        var xml = new ActiveXObject("MSXML2.DOMDocument");
        var node = xml.createElement("b");
        node.dataType = "bin.base64";
        node.text = b64;
        stream.Write(node.nodeTypedValue);
        stream.SaveToFile(icoPath, 2);
        stream.Close();
      }
    } catch(e) {}
  })();


  // ── First-run: create Desktop shortcut automatically ──
  function firstRunSetup() {
    try {
      var sh  = new ActiveXObject("WScript.Shell");
      var fso = new ActiveXObject("Scripting.FileSystemObject");

      // Skip if already done
      var done = "";
      try { done = sh.RegRead("HKCU\\Software\\QuickOff\\ShortcutCreated"); } catch(e) {}
      if (done === "1") return;

      // Resolve paths — use href + unescape so %20 spaces decode correctly
      var htaPath = unescape(window.location.href.replace(/^file:\/\/\//i, "").replace(/\//g, "\\"));
      var htaDir  = fso.GetParentFolderName(htaPath);
      var icoPath = htaDir + "\\QuickOff.ico";
      var desktop = sh.SpecialFolders("Desktop");
      var lnkPath = desktop + "\\QuickOff.lnk";
      var tmpPs1  = fso.GetSpecialFolder(2) + "\\qo_shortcut.ps1";

      // Write a PS1 script to temp folder — avoids inline quoting issues
      var ps1 =
        "$sh  = New-Object -ComObject WScript.Shell\r\n" +
        "$lnk = $sh.CreateShortcut('" + lnkPath + "')\r\n" +
        "$lnk.TargetPath       = 'mshta.exe'\r\n" +
        "$lnk.Arguments        = '\"" + htaPath + "\"'\r\n" +
        "$lnk.WorkingDirectory = '" + htaDir + "'\r\n" +
        "$lnk.IconLocation     = '" + icoPath + ",0'\r\n" +
        "$lnk.Description      = 'QuickOff Power Menu'\r\n" +
        "$lnk.Save()\r\n";

      var ts = fso.OpenTextFile(tmpPs1, 2, true);
      ts.Write(ps1);
      ts.Close();

      // Run PS1 hidden, wait for it to finish
      sh.Run('powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File "' + tmpPs1 + '"', 0, true);

      // Clean up temp file
      try { fso.DeleteFile(tmpPs1); } catch(e2) {}

      // Mark done
      sh.RegWrite("HKCU\\Software\\QuickOff\\ShortcutCreated", "1", "REG_SZ");
    } catch(e) {}
  }

  firstRunSetup();
  checkUpdate();
</script>
</body>
</html>
