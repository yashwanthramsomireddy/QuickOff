<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta charset="UTF-8">
<title>QuickOff</title>
<HTA:APPLICATION
  ID="QuickOff"
  APPLICATIONNAME="QuickOff"
  VERSION="1.1.1"
  BORDER="none"
  BORDERSTYLE="none"
  CAPTION="no"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="no"
  SCROLL="no"
  SINGLEINSTANCE="yes"
  WINDOWSTATE="normal"
  INNERBORDER="no"
  SELECTION="no"
  CONTEXTMENU="no"
/>
<style>
* { margin:0; padding:0; box-sizing:border-box; }

body {
  font-family: 'Segoe UI', Tahoma, sans-serif;
  background: #080808;
  color: #e8e8e8;
  width: 200px;
  overflow: hidden;
  border: 1px solid #222;
  border-radius: 10px;
  position: relative;
}

#btn-close {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: #1a1a1a;
  border: 1px solid #333;
  color: #555;
  font-size: 10px;
  font-weight: 700;
  line-height: 16px;
  text-align: center;
  cursor: pointer;
  z-index: 10;
  font-family: 'Segoe UI', sans-serif;
  transition: background 0.15s, color 0.15s;
}
#btn-close:hover { background: #c0392b; border-color: #c0392b; color: #fff; }

#ver {
  position: absolute;
  top: 11px;
  left: 10px;
  font-size: 9px;
  color: #2a2a2a;
  letter-spacing: 0.5px;
  font-weight: 700;
  z-index: 10;
}

#top-gap { height: 34px; cursor: move; }

.div { height: 1px; background: #111; margin: 0; }

.pwr {
  width: 100%;
  background: transparent;
  border: none;
  border-left: 2px solid transparent;
  color: #888;
  padding: 0 12px;
  height: 36px;
  cursor: pointer;
  font-family: 'Segoe UI', sans-serif;
  font-size: 12px;
  font-weight: 400;
  text-align: left;
  display: -ms-flexbox;
  display: flex;
  -ms-flex-align: center;
  align-items: center;
  gap: 10px;
  transition: background 0.1s, color 0.1s, border-color 0.1s;
}
.pwr:hover { background: #0f0f0f; color: #f0f0f0; }
.pwr:active { background: #080808; }

.pwr .ic {
  font-size: 13px;
  width: 16px;
  text-align: center;
  -ms-flex-negative: 0;
  flex-shrink: 0;
  color: #444;
}
.pwr:hover .ic { color: inherit; }

.h-btn:hover  { border-left-color: #7c3aed; }
.sl-btn:hover { border-left-color: #0891b2; }
.sd-btn:hover { border-left-color: #dc2626; }
.rs-btn:hover { border-left-color: #ea580c; }
.lk-btn:hover { border-left-color: #ca8a04; }
.lo-btn:hover { border-left-color: #6366f1; }

#delay-row {
  display: -ms-flexbox;
  display: flex;
  -ms-flex-align: center;
  align-items: center;
  padding: 6px 12px;
  gap: 6px;
  background: #050505;
  border-top: 1px solid #111;
}
#delay-row label { font-size: 10px; color: #333; -ms-flex:1; flex:1; }
#delay-row input {
  width: 38px;
  background: #0f0f0f;
  border: 1px solid #1c1c1c;
  border-radius: 4px;
  color: #666;
  font-size: 11px;
  padding: 2px 4px;
  text-align: center;
  font-family: 'Segoe UI', sans-serif;
}
#delay-row span { font-size: 10px; color: #2a2a2a; }

#footer { background: #050505; padding: 4px 10px 8px; }

#status {
  font-size: 9px;
  color: #222;
  text-align: center;
  padding: 3px 0;
  min-height: 15px;
  letter-spacing: 0.3px;
}
#status.on { color: #3a5a8f; }

#btn-abort {
  width: 100%;
  background: transparent;
  border: 1px solid #141414;
  border-radius: 4px;
  color: #2a2a2a;
  font-family: 'Segoe UI', sans-serif;
  font-size: 10px;
  padding: 4px;
  cursor: pointer;
  transition: background 0.1s, color 0.1s, border-color 0.1s;
}
#btn-abort:hover { background: #0f0f0f; color: #555; border-color: #222; }

#overlay {
  display: none;
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.95);
  border-radius: 10px;
  text-align: center;
  z-index: 50;
  padding-top: 42px;
}
#overlay.show { display: block; }

#ov-ic  { font-size: 26px; display: block; margin-bottom: 8px; }
#ov-ttl { font-size: 13px; font-weight: 700; color: #ddd; margin-bottom: 4px; }
#ov-sub { font-size: 10px; color: #3a3a3a; margin: 0 14px 14px; line-height: 1.5; }

.ov-yes, .ov-no {
  display: inline-block;
  padding: 6px 16px;
  border-radius: 5px;
  border: none;
  font-family: 'Segoe UI', sans-serif;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  margin: 0 3px;
}
.ov-yes { background: #991b1b; color: #fff; }
.ov-yes:hover { background: #7f1d1d; }
.ov-no  { background: #0f0f0f; border: 1px solid #1f1f1f; color: #666; }
.ov-no:hover { background: #161616; color: #999; }
</style>
</head>
<body>

<div id="overlay">
  <span id="ov-ic">&#9889;</span>
  <div id="ov-ttl">Confirm</div>
  <div id="ov-sub">Proceed?</div>
  <button class="ov-yes" onclick="doAction()">Yes</button>
  <button class="ov-no"  onclick="hideOv()">No</button>
</div>

<button id="btn-close" onclick="window.close()" title="Close">&#215;</button>
<div id="ver">QUICKOFF &nbsp;v1.1.1</div>
<div id="top-gap"></div>

<div class="div"></div>
<button class="pwr h-btn"  onclick="ask('hibernate')"><span class="ic">&#9790;</span>Hibernate</button>
<div class="div"></div>
<button class="pwr sl-btn" onclick="ask('sleep')">    <span class="ic">&#8776;</span>Sleep</button>
<div class="div"></div>
<button class="pwr sd-btn" onclick="ask('shutdown')"> <span class="ic">&#9866;</span>Shut Down</button>
<div class="div"></div>
<button class="pwr rs-btn" onclick="ask('restart')">  <span class="ic">&#8635;</span>Restart</button>
<div class="div"></div>
<button class="pwr lk-btn" onclick="ask('lock')">     <span class="ic">&#9632;</span>Lock</button>
<div class="div"></div>
<button class="pwr lo-btn" onclick="ask('signout')">  <span class="ic">&#8594;</span>Sign Out</button>
<div class="div"></div>

<div id="delay-row">
  <label>Delay</label>
  <input type="number" id="delay" value="0" min="0" max="3600" />
  <span>sec</span>
</div>

<div id="footer">
  <div id="status">Ready</div>
  <button id="btn-abort" onclick="abortAll()">&#215; Abort</button>
</div>

<script language="VBScript">
  Sub RunCmd(cmd)
    CreateObject("WScript.Shell").Run cmd, 0, False
  End Sub
</script>

<script language="JavaScript">
  var W = 200, H = 306;
  window.resizeTo(W, H);
  window.moveTo(screen.availWidth - W - 14, screen.availHeight - H - 46);

  var A = {
    hibernate: { ic:"&#9790;",  title:"Hibernate",  sub:"Save session to disk and power off.", cmd:"shutdown /h" },
    sleep:     { ic:"&#8776;",  title:"Sleep",       sub:"Enter low-power standby.",             cmd:"cmd /c \"rundll32.exe powrprof.dll,SetSuspendState 0,1,0\"" },
    shutdown:  { ic:"&#9866;",  title:"Shut Down",   sub:"Close all apps and power off.",        cmd:"shutdown /s /t 0" },
    restart:   { ic:"&#8635;",  title:"Restart",     sub:"Reboot Windows.",                      cmd:"shutdown /r /t 0" },
    lock:      { ic:"&#9632;",  title:"Lock",        sub:"Lock your session.",                   cmd:"cmd /c \"rundll32.exe user32.dll,LockWorkStation\"" },
    signout:   { ic:"&#8594;",  title:"Sign Out",    sub:"Sign out of Windows.",                 cmd:"shutdown /l" }
  };

  var pending = "", timer = null;

  function ask(action) {
    pending = action;
    var a = A[action];
    var delay = parseInt(document.getElementById("delay").value) || 0;
    document.getElementById("ov-ic").innerHTML  = a.ic;
    document.getElementById("ov-ttl").innerText = a.title;
    document.getElementById("ov-sub").innerText = delay > 0 ? "In " + delay + " seconds." : a.sub;
    document.getElementById("overlay").className = "show";
  }

  function hideOv() {
    document.getElementById("overlay").className = "";
    pending = "";
  }

  function doAction() {
    var action = pending; // capture BEFORE hideOv() clears it
    hideOv();
    if (!action) return;
    var a = A[action];
    var delay = parseInt(document.getElementById("delay").value) || 0;
    if (action === "shutdown" || action === "restart") {
      window.RunCmd(action === "shutdown" ? "shutdown /s /t " + delay : "shutdown /r /t " + delay);
      setStatus(delay > 0 ? a.title + " in " + delay + "s" : a.title + " sent", true);
    } else if (delay > 0) {
      countdown(delay, a);
    } else {
      window.RunCmd(a.cmd);
      setStatus(a.title + " sent", true);
    }
  }

  function countdown(secs, a) {
    if (timer) clearInterval(timer);
    var left = secs;
    setStatus(a.title + " in " + left + "s", true);
    timer = setInterval(function() {
      left--;
      if (left <= 0) {
        clearInterval(timer); timer = null;
        window.RunCmd(a.cmd);
        setStatus(a.title + " sent", true);
      } else {
        setStatus(a.title + " in " + left + "s", true);
      }
    }, 1000);
  }

  function abortAll() {
    if (timer) { clearInterval(timer); timer = null; }
    window.RunCmd("shutdown /a");
    setStatus("Aborted", false);
  }

  function setStatus(msg, on) {
    var el = document.getElementById("status");
    el.innerText = msg;
    el.className = on ? "on" : "";
  }

  // ── Drag on top gap ──────────────────────────
  var dragging = false, ox = 0, oy = 0;
  document.getElementById("top-gap").onmousedown = function(e) {
    dragging = true;
    ox = e.screenX - window.screenLeft;
    oy = e.screenY - window.screenTop;
  };
  document.onmousemove = function(e) {
    if (dragging) window.moveTo(e.screenX - ox, e.screenY - oy);
  };
  document.onmouseup = function() { dragging = false; };
</script>
</body>
</html>
